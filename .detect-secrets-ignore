# Per-repo secret detection exclusions for terra-wrangler.
# One regex per line; lines starting with # are comments.
# These supplement the global exclusions in scripts/detect_secrets_baseline.sh.

# TERRAFORM_GUIDELINES.md and validator code contain example ARNs, account
# IDs, and emails used purely as illustrative HCL snippets.
TERRAFORM_GUIDELINES\.md
scripts/validate_terraform\.py
src/pds/terra_wrangler/validator\.py
tests/pds/terra_wrangler/test_validate_terraform\.py

# Python artifacts and caches
\.mypy_cache
\.pytest_cache
\.tox
\.venv
venv
.*\.egg-info
__pycache__
.*\.pyc
.*\.pyo
.*\.pyd

# Editor and IDE artifacts
\.vscode
\.idea
.*\.swp
.*~
